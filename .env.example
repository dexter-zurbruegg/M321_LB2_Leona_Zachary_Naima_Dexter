# Vorlage für .env (die echte .env ist in .gitignore und kommt NIE ins Repo, N03).
# Am einfachsten: ./scripts/init-env.sh erzeugt eine .env mit zufälligen Werten.
GATEWAY_PORT=8080
# Gemeinsames Secret für die JWT-Signatur (HS256). Alle Services brauchen denselben Wert.
JWT_SECRET=hier-langen-zufallswert-eintragen
JWT_TTL_SECONDS=3600
POSTGRES_PASSWORD=hier-aendern
USER_DB_PASSWORD=hier-aendern
TODO_DB_PASSWORD=hier-aendern
CATEGORY_DB_PASSWORD=hier-aendern
